{
  "name": "qlayo-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --exclude output/**",
    "prepare:pdf": "node scripts/prepare-pdf.mjs",
    "predev": "npm run prepare:pdf",
    "prebuild": "npm run prepare:pdf",
    "postbuild": "node scripts/collect-notices.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@react-three/fiber": "^9.0.0",
    "@tabler/icons-react": "^3.46.0",
    "pdfjs-dist": "^6.3.289",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "屋面和车棚光伏布置与实景预览工作台",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qinzeiwang/qlayo-core.git"
  },
  "license": "SEE LICENSE IN LICENSE.md"
}
